rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mnshiddik11@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'role', 'balance', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'role', 'balance', 'totalNumbers', 'totalOtps', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() <= 128
        && data.displayName is string && data.displayName.size() <= 100
        && (data.role == 'user' || data.role == 'admin')
        && data.balance is number
        && data.createdAt is string
        && data.updatedAt is string;
    }

    // Validation for SmsOrder
    function isValidSmsOrder(data) {
      return data.keys().hasAll(['id', 'userId', 'phoneNumber', 'service', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'phoneNumber', 'service', 'country', 'range', 'price', 'status', 'otpCode', 'fullMessage', 'zenexId', 'expiresAt', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.phoneNumber is string && data.phoneNumber.size() <= 32
        && data.service is string && data.service.size() <= 64
        && (data.status == 'WAITING' || data.status == 'RECEIVED' || data.status == 'EXPIRED' || data.status == 'CANCELLED')
        && (!('otpCode' in data) || (data.otpCode is string && data.otpCode.size() <= 64))
        && (!('fullMessage' in data) || (data.fullMessage is string && data.fullMessage.size() <= 1000))
        && (!('range' in data) || (data.range is string && data.range.size() <= 64))
        && (!('price' in data) || data.price is number)
        && data.createdAt is string
        && data.updatedAt is string;
    }

    // Validation for BroadcastLog
    function isValidBroadcastLog(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'type', 'createdAt'])
        && data.keys().hasOnly(['id', 'title', 'message', 'type', 'createdAt', 'authorId'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 128
        && data.message is string && data.message.size() <= 1000
        && (data.type == 'INFO' || data.type == 'ALERT' || data.type == 'UPDATE' || data.type == 'RANGE_ADDED')
        && data.createdAt is string;
    }

    // Test connection document
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // User collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false; // Blanket user enumeration blocked
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().role == 'user';
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().role == existing().role
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'balance', 'totalNumbers', 'totalOtps', 'updatedAt']);
      allow delete: if isAdmin();

      // User's SMS orders subcollection
      match /smsOrders/{orderId} {
        allow get: if isOwner(userId) && isValidId(orderId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(orderId)
          && incoming().userId == request.auth.uid
          && isValidSmsOrder(incoming());
        allow update: if isOwner(userId)
          && isValidId(orderId)
          && incoming().userId == existing().userId
          && isValidSmsOrder(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'otpCode', 'fullMessage', 'updatedAt', 'price']);
        allow delete: if isOwner(userId) && isValidId(orderId);
      }
    }

    // Global broadcast logs
    match /broadcastLogs/{logId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(logId) && (request.method == 'delete' || isValidBroadcastLog(incoming()));
    }
  }
}
